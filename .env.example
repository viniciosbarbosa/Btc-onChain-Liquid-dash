# Bitcoin & Liquid Dashboard Environment Configuration Template
# Copy this file to .env for local dev node configuration

VITE_TOR_GATEWAY_MODE=onion.ly
VITE_LOCAL_TOR_PROXY_URL=http://localhost:9050

VITE_BITCOIN_ONION_API=http://umbrel.local:3002/api

VITE_LIQUID_P2P_HOST=your-liquid-p2p-node.onion
VITE_LIQUID_P2P_PORT=18332
VITE_LIQUID_RPC_HOST=your-liquid-rpc-node.onion
VITE_LIQUID_RPC_PORT=7041
VITE_LIQUID_RPC_USER=elements
VITE_LIQUID_RPC_PASS=YOUR_ELEMENTS_RPC_PASSWORD
VITE_LIQUID_ELECTRUM_HOST=your-liquid-electrum-node.onion
VITE_LIQUID_ELECTRUM_PORT=50001

VITE_BTC_PUBLIC_FALLBACK=https://mempool.space/api
VITE_LIQUID_PUBLIC_FALLBACK=https://blockstream.info/liquid/api
